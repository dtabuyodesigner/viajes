rn { ok:true, cambios:false }; } const fundido = this.fundir(antes, { hechas: remoto.hechas || {}, desmarcadas: remoto.desmarcadas || {}, notas: remoto.notas || {}, posiciones: remoto.posiciones || {}, visitas: remoto.visitas || [], pernoctas: remoto.pernoctas || [], portadas: remoto.portadas || {} }); const cambios = JSON.stringify(fundido) !== JSON.stringify(antes); this.guardarLocal(viaje, fundido); if (cambios) await this.subir(viaje); return { ok:true, cambios }; } }; /* ═══════════════════════════════════════════════════════════ Fotos del viaje. Van en IndexedDB, no en localStorage: allí solo caben unos 5 MB en total y tres fotos ya lo llenarían. Aquí caben cientos. Se guardan en el móvil. No se sincronizan todavía: una foto comprimida son 100 KB y meterlas en la fila del viaje sería pesado. Para compartirlas, de momento, el compartir del móvil. ═══════════════════════════════════════════════════════════ */ const FOTOS = { _bd: null, async abrir(){ if (this._bd) return this._bd; if (!window.indexedDB) return null; return new Promise(ok => { const p = indexedDB.open(\"viajes_fotos\", 1); p.onupgradeneeded = () => { const bd = p.result; if (!bd.objectStoreNames.contains(\"fotos\")) bd.createObjectStore(\"fotos\", { keyPath: \"id\" }); }; p.onsuccess = () => { this._bd = p.result; ok(this._bd); }; p.onerror = () => ok(null); setTimeout(() => ok(null), 5000); }); }, async _tienda(modo){ const bd = await this.abrir(); if (!bd) return null; try { return bd.transaction(\"fotos\", modo).objectStore(\"fotos\"); } catch { return null; } }, /* Guarda una foto y devuelve su id */ async guardar(viaje, dia, datos, xy){ const t = await this._tienda(\"readwrite\"); if (!t) return null; const id = `${viaje}:${dia}:${Date.now()}`; const guardado = await new Promise(ok => { const p = t.put({ id, viaje, dia, datos, xy: xy || null, cuando: Date.now() }); p.onsuccess = () => ok(id); p.onerror = () => ok(null); }); if (guardado) this.subir(id).catch(()=>{}); return guardado; }, /* Todas las de un día, de la más antigua a la más nueva */ async delDia(viaje, dia){ const t = await this._tienda(\"readonly\"); if (!t) return []; return new Promise(ok => { const fuera = []; const p = t.openCursor(); p.onsuccess = e => { const c = e.target.result; if (!c) return ok(fuera.sort((a,b) => a.cuando - b.cuando)); if (c.value.viaje === viaje && String(c.value.dia) === String(dia)) fuera.push(c.value); c.continue(); }; p.onerror = () => ok([]); }); }, /* Cuántas hay por día, para pintar las miniaturas de la lista */ async cuentaPorDia(viaje){ const t = await this._tienda(\"readonly\"); if (!t) return {}; return new Promise(ok => { const n = {}; const p = t.openCursor(); p.onsuccess = e => { const c = e.target.result; if (!c) return ok(n); if (c.value.viaje === viaje) n[c.value.dia] = (n[c.value.dia] || 0) + 1; c.continue(); }; p.onerror = () => ok({}); }); }, async una(id){ return this._porId(id); }, async borrar(id){ const t = await this._tienda(\"readwrite\"); if (!t) return false; const fuera = await new Promise(ok => { const p = t.delete(id); p.onsuccess = () => ok(true); p.onerror = () => ok(false); }); this.marcarBorradaFuera(id).catch(()=>{}); return fuera; }, /* ---- Compartir con el otro móvil ---- */ pendientes(){ try { return JSON.parse(localStorage.getItem(\"fotos_pendientes\")) || []; } catch { return []; } }, _apuntarPendiente(id){ const p = new Set(this.pendientes()); p.add(id); try { localStorage.setItem(\"fotos_pendientes\", JSON.stringify([...p])); } catch {} }, _quitarPendiente(id){ try { localStorage.setItem(\"fotos_pendientes\", JSON.stringify(this.pendientes().filter(x => x !== id))); } catch {} }, async _porId(id){ const t = await this._tienda(\"readonly\"); if (!t) return null; return new Promise(ok => { const p = t.get(id); p.onsuccess = () => ok(p.result || null); p.onerror = () => ok(null); }); }, async subir(id){ const c = await SYNC.conectar(); if (!c || !SYNC.sesion){ this._apuntarPendiente(id); return false; } const f = await this._porId(id); if (!f){ this._quitarPendiente(id); return false; } try { const { error } = await c.from(\"viaje_fotos\").upsert({ id: f.id, viaje: f.viaje, dia: f.dia, datos: f.datos, autor: SYNC.sesion.user?.email || \"\", borrada: false }); if (error) throw error; this._quitarPendiente(id); return true; } catch { this._apuntarPendiente(id); return false; } }, async marcarBorradaFuera(id){ const c = await SYNC.conectar(); if (!c || !SYNC.sesion) return false; try { await c.from(\"viaje_fotos\").update({ borrada:true }).eq(\"id\", id); this._quitarPendiente(id); return true; } catch { return false; } }, /* Trae del otro móvil las fotos de un día que aquí no estén. Primero pregunta qué ids hay (ligero) y solo baja las que faltan. */ async traerDelDia(viaje, dia){ const c = await SYNC.conectar(); if (!c || !SYNC.sesion) return 0; // lo pendiente de subir, primero for (const id of this.pendientes()) await this.subir(id); let fuera = []; try { const { data, error } = await c.from(\"viaje_fotos\") .select(\"id,borrada\").eq(\"viaje\", viaje).eq(\"dia\", dia); if (error) throw error; fuera = data || []; } catch { return 0; } const aqui = new Set((await this.delDia(viaje, dia)).map(f => f.id)); let nuevas = 0; for (const f of fuera){ if (f.borrada){ if (aqui.has(f.id)){ const t = await this._tienda(\"readwrite\"); if (t) t.delete(f.id); nuevas++; } continue; } if (aqui.has(f.id)) continue; try { const { data, error } = await c.from(\"viaje_fotos\") .select(\"id,viaje,dia,datos,cuando\").eq(\"id\", f.id).maybeSingle(); if (error || !data) continue; const t = await this._tienda(\"readwrite\"); if (!t) continue; t.put({ id:data.id, viaje:data.viaje, dia:data.dia, datos:data.datos, cuando: Date.parse(data.cuando) || Date.now() }); nuevas++; } catch {} } return nuevas; }, /* Cuánto ocupan, para avisar antes de llenar el móvil */ async espacio(){ try { if (!navigator.storage?.estimate) return null; const e = await navigator.storage.estimate(); return { usado: e.usage || 0, total: e.quota || 0 }; } catch { return null; } } }; /* Comprime antes de guardar: una foto de iPhone son 4 MB, esto la deja en ~120 KB */ function comprimirFoto(archivo, maxLado = 1400, calidad = 0.75){ return new Promise((ok, mal) => { const lector = new FileReader(); lector.onload = () => { const img = new Image(); img.onload = () => { let { width:a, height:b } = img; const f = Math.min(1, maxLado / Math.max(a, b)); a = Math.round(a * f); b = Math.round(b * f); const c = document.createElement(\"canvas\"); c.width = a; c.height = b; c.getContext(\"2d\").drawImage(img, 0, 0, a, b); ok(c.toDataURL(\"image/jpeg\", calidad)); }; img.onerror = mal; img.src = lector.result; }; lector.onerror = mal; lector.readAsDataURL(archivo); }); } // Reintento automático al recuperar la cobertura window.addEventListener(\"online\", () => { SYNC.sincronizar().catch(()=>{}); FOTOS.pendientes().forEach(id => FOTOS.subir(id).catch(()=>{})); }); </script> <script> /* ---- Modo de color, compartido por todas las apps ---- */ const TEMA = { get valor(){ try { return localStorage.getItem(\"tema_viajes\") || \"auto\"; } catch { return \"auto\"; } }, set valor(v){ try { localStorage.setItem(\"tema_viajes\", v); } catch {}; this.aplica(); }, pintaMini(){ const z = document.getElementById(\"tema-zona\"); if (!z) return; z.innerHTML = this.mini(); z.querySelectorAll(\"[data-tema]\").forEach(b => b.addEventListener(\"click\", () => { TEMA.valor = b.dataset.tema; TEMA.pintaMini(); })); }, aplica(){ const v = this.valor; document.body.classList.toggle(\"claro\", v === \"claro\"); document.body.classList.toggle(\"auto\", v === \"auto\"); const m = document.querySelector('meta[name=\"theme-color\"]'); if (!m) return; const oscuro = m.dataset.oscuro || m.getAttribute(\"content\"); if (!m.dataset.oscuro) m.dataset.oscuro = oscuro; const claroDeVerdad = v === \"claro\" || (v === \"auto\" && window.matchMedia && matchMedia(\"(prefers-color-scheme: light)\").matches); m.setAttribute(\"content\", claroDeVerdad ? \"#F4F6F7\" : m.dataset.oscuro); }, mini(){ const v = this.valor; const b = (id, t, etiqueta) => `<button class=\"tm${v === id ? \" on\" : \"\"}\" data-tema=\"${id}\" aria-label=\"${etiqueta}\" title=\"${etiqueta}\">${t}</button>`; return `<div class=\"tema-mini\">${b(\"auto\",\"◐\",\"Automático\")}${b(\"claro\",\"☀\",\"Claro\")}${b(\"oscuro\",\"☾\",\"Oscuro\")}</div>`; }, opciones(){ const v = this.valor; const b = (id, t, sub) => `<button class=\"op${v === id ? \" on\" : \"\"}\" data-tema=\"${id}\"><b>${t}</b><small>${sub}</small></button>`; return `<div class=\"ops\">${b(\"auto\",\"Automático\",\"Como el móvil\")}${b(\"claro\",\"Claro\",\"Para el sol\")}${b(\"oscuro\",\"Oscuro\",\"Para la noche\")}</div>`; }, engancha(volver){ document.querySelectorAll(\"[data-tema]\").forEach(x => x.addEventListener(\"click\", () => { TEMA.valor = x.dataset.tema; volver && volver(); })); } }; if (window.matchMedia) matchMedia(\"(prefers-color-scheme: light)\").addEventListener?.(\"change\", () => TEMA.aplica()); const VIAJES = [ { id:\"eslovenia\", n:\"Eslovenia y Venecia\", ruta:\"eslovenia/\", desde:\"2026-07-18\", hasta:\"2026-07-29\", acento:\"#4FC3B8\", img:\"img/eslovenia-portada.svg\" }, { id:\"asturias\", n:\"Asturias occidental\", ruta:\"asturias/\", desde:\"\", hasta:\"\", acento:\"#7FB069\", art:`<svg viewBox=\"0 0 400 104\" preserveAspectRatio=\"xMidYMid slice\"> <rect width=\"400\" height=\"104\" fill=\"#0F1E14\"/> <path d=\"M0 104L110 20l70 50 60-36 160 70z\" fill=\"#1A2E20\"/> <path d=\"M0 104L150 48l130 56z\" fill=\"#24422A\"/> <ellipse cx=\"120\" cy=\"80\" rx=\"46\" ry=\"11\" fill=\"#5AA9C4\" opacity=\".55\"/> <g fill=\"#0F1E14\"><path d=\"M60 70l10-15 10 15z\"/><path d=\"M300 96l12-18 12 18z\"/></g> <g stroke=\"#C89B3C\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\"> <path d=\"M250 104h60l-40-13h62\"/></g></svg>` } ]; const VERSION = \"VERSIÓN\"; const MESES = [\"ene\",\"feb\",\"mar\",\"abr\",\"may\",\"jun\",\"jul\",\"ago\",\"sep\",\"oct\",\"nov\",\"dic\"]; const hoy = (() => { const n = new Date(); return `${n.getFullYear()}-${String(n.getMonth()+1).padStart(2,\"0\")}-${String(n.getDate()).padStart(2,\"0\")}`; })(); function textoFechas(v){ if (!v.desde) return \"Sin fechas todavía\"; const a = new Date(v.desde+\"T12:00:00\"), b = new Date(v.hasta+\"T12:00:00\"); return `${a.getDate()} ${MESES[a.getMonth()]} — ${b.getDate()} ${MESES[b.getMonth()]} ${b.getFullYear()}`; } function estado(v){ if (!v.desde) return [\"futuro\",\"Por planear\"]; if (hoy < v.desde) return [\"futuro\",\"Próximamente\"]; if (hoy > v.hasta) return [\"hecho\",\"Terminado\"]; const d = Math.round((new Date(hoy) - new Date(v.desde)) / 86400000) + 1; return [\"curso\", `En curso · día ${d}`]; } function propios(){ try { return (JSON.parse(localStorage.getItem(\"viajes_propios\")) || []).map(v => ({ id:v.id, n:v.nombre, ruta:`viaje/?id=${v.id}`, desde:v.desde||\"\", hasta:v.hasta||\"\", acento:\"#5BC8B4\", propio:true, ndias:(v.dias||[]).length, art:`<svg viewBox=\"0 0 400 104\" preserveAspectRatio=\"xMidYMid slice\"> <rect width=\"400\" height=\"104\" fill=\"#101C22\"/> <path d=\"M0 104L120 34l70 42 60-26 150 54z\" fill=\"#1A2A32\"/> <path d=\"M0 104L160 58l140 46z\" fill=\"#223A42\"/> <g stroke=\"#5BC8B4\" stroke-width=\"2.4\" fill=\"none\" stroke-linecap=\"round\" stroke-dasharray=\"3 6\" opacity=\".85\"><path d=\"M40 92 L130 60 L230 74 L340 40\"/></g> <g fill=\"#5BC8B4\"><circle cx=\"40\" cy=\"92\" r=\"4\"/><circle cx=\"130\" cy=\"60\" r=\"4\"/> <circle cx=\"230\" cy=\"74\" r=\"4\"/><circle cx=\"340\" cy=\"40\" r=\"4\"/></g></svg>` })); } catch { return []; } } let TODOS = VIAJES.concat(propios()); function pintaLista(){ document.getElementById(\"lista\").innerHTML = TODOS.map(v => { const [cls, txt] = estado(v); const txt2 = v.propio && !v.desde ? `${v.ndias} día${v.ndias === 1 ? \"\" : \"s\"} · sin fechas` : txt; return `<a class=\"viaje ${cls}\" href=\"${v.ruta}\" style=\"--acento:${v.acento}\"> ${v.img ? `<img class=\"art\" src=\"${v.img}\" alt=\"${v.n}\" loading=\"lazy\">` : `<span class=\"art\">${v.art}</span>`} <span class=\"cuerpo\"> <h2>${v.n}</h2> <p class=\"fechas\">${textoFechas(v)}</p> <span class=\"estado\"><span class=\"punto\"></span>${txt2}</span> <span class=\"flecha\">→</span> </span> </a>`; }).join(\"\"); const enCurso = TODOS.find(v => estado(v)[0] === \"curso\"); document.getElementById(\"saludo\").textContent = enCurso ? \"Viaje en curso\" : \"Viajes\"; } function pintaPie(){ document.getElementById(\"pie\").innerHTML = ` <a class=\"crear\" href=\"crear/\"> <span class=\"mas\">+</span> <span><b>Crear un viaje</b><small>Días, paradas y navegación, montado por ti</small></span> </a> <div class=\"mantenimiento\"> <p class=\"ver\">Versión ${VERSION} · <span id=\"nube\"></span></p> <button class=\"btn-act\" id=\"btn-actualizar\">Buscar actualización</button> <button class=\"btn-act ligero\" id=\"btn-compartir\">Compartir la app</button> <p class=\"nota\" style=\"margin-top:10px\">Actualiza esta portada y los viajes a la vez.</p> <div id=\"cuenta\"></div> </div> <p class=\"nota\">Cada viaje funciona sin cobertura una vez abierto con datos. Puedes añadir cualquiera a la pantalla de inicio por separado.</p>`; ponEstado(ultimoEstado); document.getElementById(\"btn-compartir\").addEventListener(\"click\", async () => { const b = document.getElementById(\"btn-compartir\"); const url = location.origin + location.pathname; const texto = `Apps de viaje que funcionan sin cobertura: itinerario, navegación, ` + `qué hay cerca y diario del viaje.\\n\\n${url}\\n\\n` + `Se abre en el navegador. Para tenerla como una app: Compartir → Añadir a pantalla de inicio.`; try { if (navigator.share) await navigator.share({ title:\"Viajes\", text:texto, url }); else { await navigator.clipboard.writeText(url); b.textContent = \"Enlace copiado\"; } } catch {} setTimeout(() => { b.textContent = \"Compartir la app\"; }, 2500); }); document.getElementById(\"btn-actualizar\").addEventListener(\"click\", async e => { const b = e.target; b.textContent = \"Limpiando…\"; try { // Cada carpeta tiene su propio service worker y getRegistrations() solo // devuelve el de esta. Hay que ir a por los demás uno por uno. if (\"serviceWorker\" in navigator){ const carpetas = [\"./\", \"eslovenia/\", \"asturias/\", \"viaje/\", \"crear/\"]; for (const c of carpetas){ try { const reg = await navigator.serviceWorker.getRegistration(c); if (reg) await reg.unregister(); } catch {} } // y por si quedara alguno más const regs = await navigator.serviceWorker.getRegistrations(); await Promise.all(regs.map(r => r.unregister())); } if (window.caches){ const ks = await caches.keys(); await Promise.all(ks.map(k => caches.delete(k))); } } catch {} b.textContent = \"Recargando…\"; location.replace(location.pathname + \"?v=\" + Date.now()); }); } /* ---- Nube ---- */ let ultimoEstado = { txt:\"comprobando…\", ok:false }; function ponEstado(e){ ultimoEstado = e; const el = document.getElementById(\"nube\"); if (!el) return; el.innerHTML = e.login ? `${e.txt} · <button class=\"lnk\" id=\"abrir-login\">entrar</button>` : e.txt; el.style.color = e.ok ? \"#5BC8B4\" : \"\"; const b = document.getElementById(\"abrir-login\"); if (b) b.addEventListener(\"click\", pintaLogin); pintaSalir(e); } function pintaSalir(e){ const z = document.getElementById(\"cuenta\"); if (!z) return; z.innerHTML = e.ok && e.correo ? `<p class=\"nota\" style=\"margin:8px 0 0\">Conectado como ${e.correo} · <button class=\"lnk\" id=\"salir\">salir</button></p>` : \"\"; const s = document.getElementById(\"salir\"); if (s) s.addEventListener(\"click\", async () => { await SYNC.salir(); pintaNube(); }); } function pintaLogin(){ const z = document.getElementById(\"cuenta\"); z.innerHTML = ` <div class=\"login\"> <p class=\"nota\" style=\"margin:0 0 10px\">Entra con la misma cuenta de Gastos compartidos. En iOS, cada app de la pantalla de inicio guarda su sesión aparte.</p> <input type=\"email\" id=\"correo\" placeholder=\"tu@correo.com\" autocomplete=\"username\" autocapitalize=\"none\" spellcheck=\"false\"> <input type=\"password\" id=\"clave\" placeholder=\"Contraseña\" autocomplete=\"current-password\"> <button class=\"btn-act\" id=\"hacer-login\">Entrar</button> <p class=\"nota\" id=\"err-login\" style=\"margin:9px 0 0\"></p> </div>`; document.getElementById(\"hacer-login\").addEventListener(\"click\", async () => { const b = document.getElementById(\"hacer-login\"); const err = document.getElementById(\"err-login\"); const correo = document.getElementById(\"correo\").value.trim(); const clave = document.getElementById(\"clave\").value; if (!correo || !clave){ err.textContent = \"Falta el correo o la contraseña.\"; return; } b.textContent = \"Entrando…\"; err.textContent = \"\"; let r; try { if (typeof SYNC.entrar !== \"function\") throw new Error(\"La app está desactualizada. Pulsa «Buscar actualización».\"); r = await SYNC.entrar(correo, clave); } catch (ex){ b.textContent = \"Entrar\"; err.textContent = ex.message || \"No se pudo entrar.\"; return; } if (!r.ok){ b.textContent = \"Entrar\"; err.textContent = r.txt; return; } z.innerHTML = \"\"; pintaNube(); }); document.getElementById(\"clave\").addEventListener(\"keydown\", ev => { if (ev.key === \"Enter\") document.getElementById(\"hacer-login\").click(); }); } async function pintaNube(){ if (typeof SYNC === \"undefined\") return ponEstado({txt:\"solo en este móvil\", ok:false}); // por si algo se quedara colgado pese a los topes const red = setTimeout(() => { const el = document.getElementById(\"nube\"); if (el && el.textContent.startsWith(\"comprobando\")) ponEstado({txt:\"la nube no responde · solo en este móvil\", ok:false}); }, 15000); try { await pintaNubeReal(); } finally { clearTimeout(red); } } async function pintaNubeReal(){ try { const e = await SYNC.estado(); ponEstado(e); if (!e.ok) return; const r = await SYNC.sincronizar(); if (r.cambios){ TODOS = VIAJES.concat(propios()); pintaLista(); } const e2 = await SYNC.estado(); ponEstado(e2); } catch { ponEstado({txt:\"solo en este móvil\", ok:false}); } } TEMA.aplica(); TEMA.pintaMini(); pintaLista(); pintaPie(); setTimeout(pintaNube, 300); if (\"serviceWorker\" in navigator){ window.addEventListener(\"load\", async () => { try { const reg = await navigator.serviceWorker.register(\"sw.js\", { updateViaCache: \"none\" }); reg.update(); // Si hay una versión nueva esperando, no vale con recargar: el service // worker viejo sigue mandando hasta que se cierran todas las pestañas. // Se avisa y se recarga una sola vez, ya con el nuevo al mando. const avisar = sw => { if (!sw) return; sw.addEventListener(\"statechange\", () => { if (sw.state === \"installed\" && navigator.serviceWorker.controller) muestraNueva(reg); }); }; if (reg.waiting) muestraNueva(reg); avisar(reg.installing); reg.addEventListener(\"updatefound\", () => avisar(reg.installing)); let recargado = false; navigator.serviceWorker.addEventListener(\"controllerchange\", () => { if (recargado) return; recargado = true; location.reload(); }); } catch {} }); function muestraNueva(reg){ if (document.getElementById(\"hay-nueva\")) return; const b = document.createElement(\"button\"); b.id = \"hay-nueva\"; b.className = \"aviso-nueva\"; b.textContent = \"Hay una versión nueva · tocar para usarla\"; b.addEventListener(\"click\", () => { b.textContent = \"Actualizando…\"; reg.waiting?.postMessage({ tipo: \"aplicar\" }); setTimeout(() => location.reload(), 900); }); document.body.appendChild(b); } } </script>"
